# ==============================================================================
# CloudCode Arena - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# All variables below have safe default values for local Docker / Node development.
# Replace placeholder values with secure credentials in production environments.
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Networking & Service Ports (Host / Container)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
ASSESSMENT_SERVICE_PORT=5002
SUBMISSION_SERVICE_PORT=5003
REPORTING_SERVICE_PORT=5004
CODE_RUNNER_PORT=5005

# Public API URL used by the browser to reach the API Gateway
# In local development: http://localhost:5000
VITE_API_URL=http://localhost:5000

# Internal Service URLs for Docker internal network communication
AUTH_SERVICE_URL=http://auth-service:5001
ASSESSMENT_SERVICE_URL=http://assessment-service:5002
SUBMISSION_SERVICE_URL=http://submission-service:5003
REPORTING_SERVICE_URL=http://reporting-service:5004
CODE_RUNNER_URL=http://code-runner:5005

# For Docker Compose: Container services use internal network (configured in compose.yaml)
# For local host commands (npm run seed, npm test): connect to exposed port 27017
MONGO_URI=mongodb://127.0.0.1:27017/cloudcode_arena
MONGO_DATABASE=cloudcode_arena

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_in_production_cloudcode_arena_2026
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Initial Admin Bootstrap Key (Used ONLY in development for secure setup)
BOOTSTRAP_ADMIN_KEY=local_dev_bootstrap_admin_secret_key_98765
INITIAL_ADMIN_EMAIL=admin@cloudcode.arena
INITIAL_ADMIN_PASSWORD=AdminPass123!
INITIAL_ADMIN_NAME=Platform Administrator

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ------------------------------------------------------------------------------
# Code Execution & Isolated Runner Limits
# ------------------------------------------------------------------------------
CODE_EXEC_TIMEOUT_MS=5000
CODE_RUNNER_MEMORY_LIMIT=128m
CODE_RUNNER_CPU_LIMIT=0.5
MAX_CODE_SIZE_BYTES=65536
MAX_OUTPUT_SIZE_BYTES=65536
MAX_CONCURRENT_EXECUTIONS=10
PYTHON_RUNNER_IMAGE=python:3.11-slim

# ------------------------------------------------------------------------------
# Logging & Monitoring
# ------------------------------------------------------------------------------
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) Deployment References (Do NOT deploy automatically)
# ------------------------------------------------------------------------------
# These variables document required values for manual deployment onto GCP.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ARTIFACT_REGISTRY_REPO=cloudcode-arena-repo
GCP_SECRET_MANAGER_PREFIX=CCA_SECRET
GCP_COMPUTE_ZONE=us-central1-a

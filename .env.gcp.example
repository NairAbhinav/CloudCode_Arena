# ==============================================================================
# CloudCode Arena - Google Cloud Platform (GCP) Production Environment Template
# ==============================================================================
# Copy this template and set your actual GCP project values and secrets.
# For security: NEVER commit filled production .env files to Git repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform & Artifact Registry Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ARTIFACT_REGISTRY_REPO=cloudcode-arena-repo

# ------------------------------------------------------------------------------
# 2. Production URLs & Domain Configuration
# ------------------------------------------------------------------------------
# Domain pointing to your Ingress / Frontend VM
PUBLIC_APP_URL=https://arena.yourdomain.com
# Domain pointing to your API Gateway
PUBLIC_API_URL=https://api.arena.yourdomain.com
# Allowed origins for CORS (comma-separated if multiple)
CORS_ORIGINS=https://arena.yourdomain.com,https://api.arena.yourdomain.com

# ------------------------------------------------------------------------------
# 3. Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=super_strong_production_jwt_secret_change_me_immediately_64chars
JWT_EXPIRES_IN=24h

# Optional bootstrap key for creating the first admin account via /api/auth/bootstrap-admin
BOOTSTRAP_ADMIN_KEY=your_secure_admin_bootstrap_secret_token_12345

# ------------------------------------------------------------------------------
# 4. Internal VPC IP Addresses (Populate based on your Compute Engine setup)
# ------------------------------------------------------------------------------
# If deploying MongoDB on its own VM:
INTERNAL_DB_IP=10.128.0.2
MONGO_URI=mongodb://10.128.0.2:27017/cloudcode_arena

# If deploying Code Runner on its own isolated VM:
INTERNAL_RUNNER_IP=10.128.0.3
CODE_RUNNER_URL=http://10.128.0.3:5005

# If deploying individual backend microservices on separate VMs:
INTERNAL_AUTH_IP=10.128.0.4
INTERNAL_ASSESSMENT_IP=10.128.0.5
INTERNAL_SUBMISSION_IP=10.128.0.6
INTERNAL_REPORTING_IP=10.128.0.7

# If deploying all 4 backend microservices together on one VM:
INTERNAL_BACKEND_IP=10.128.0.4

# ------------------------------------------------------------------------------
# 5. Service Ports & Limits
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
ASSESSMENT_SERVICE_PORT=5002
SUBMISSION_SERVICE_PORT=5003
REPORTING_SERVICE_PORT=5004
CODE_RUNNER_PORT=5005

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=250
CODE_EXEC_TIMEOUT_MS=5000
